{
  "info": {
    "_postman_id": "c364ab50-831f-4d19-8f37-881dc3b304c1",
    "name": "Library Management System",
    "description": "Catalog and authentication endpoints. Set the token collection variable after registering or logging in.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "bookId",
      "value": "1"
    },
    {
      "key": "genreId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET /",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "POST /auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"strong-password-123\",\n  \"name\": \"Reader\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "POST /auth/login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"strong-password-123\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "GET /users/profile",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/users/profile"
      }
    },
    {
      "name": "GET /genres",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/genres"
      }
    },
    {
      "name": "POST /genres",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Science Fiction\",\n  \"description\": \"Speculative fiction about science and technology\"\n}"
        },
        "url": "{{baseUrl}}/genres"
      }
    },
    {
      "name": "GET /genres/:id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/genres/{{genreId}}"
      }
    },
    {
      "name": "PATCH /genres/:id",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Updated genre description\"\n}"
        },
        "url": "{{baseUrl}}/genres/{{genreId}}"
      }
    },
    {
      "name": "DELETE /genres/:id",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/genres/{{genreId}}"
      }
    },
    {
      "name": "GET /books",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books?genreId={{genreId}}&search=fiction&page=1&limit=10"
      }
    },
    {
      "name": "POST /books",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9780441013593\",\n  \"totalCopies\": 5,\n  \"genreId\": 1\n}"
        },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "GET /books/:id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "PATCH /books/:id",
      "request": {
        "method": "PATCH",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"totalCopies\": 6\n}"
        },
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "DELETE /books/:id",
      "request": {
        "method": "DELETE",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    }
  ]
}
